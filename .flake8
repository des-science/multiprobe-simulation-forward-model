[flake8]
# Recommend matching the black line length (119, set in pyproject.toml),
# rather than using the flake8 default of 79:
max-line-length = 120
extend-ignore =
    # See https://github.com/PyCQA/pycodestyle/issues/373
    E203,W503
exclude =
    .git,
    __pycache__,
    .venv,
    build,
    dist,
    *.egg-info,
    .ipynb_checkpoints,
    # Retired code, kept for reference only. It does not even import cleanly
    # (run_grid_tfrecords.py references an undefined n_noise_per_example).
    msfm/apps/deprecated
